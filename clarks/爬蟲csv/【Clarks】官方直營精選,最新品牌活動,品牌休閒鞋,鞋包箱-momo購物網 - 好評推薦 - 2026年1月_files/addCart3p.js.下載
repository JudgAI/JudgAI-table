  /**
   * 依照欄位名移除重複的object
   * @param {Array} array 
   * @param {string} columnName 
   * @returns 
   */
  removeDuplicates: function (array, columnName) {
    const seen = new Set();
    return array.filter(item => {
      if (seen.has(item[columnName])) {
        return false;
      } else {
        seen.add(item[columnName]);
        return true;
      }
    })
  },
