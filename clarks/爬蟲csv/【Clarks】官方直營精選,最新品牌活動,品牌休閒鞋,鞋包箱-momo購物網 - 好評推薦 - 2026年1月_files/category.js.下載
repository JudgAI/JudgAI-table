    _redirectUrl += (/^\s*$/.test(_advTvshop)?'':('&advTV=' + _advTvshop));
    _redirectUrl += (/^\s*$/.test(_advChina)?'':('&advChina=' + _advChina));
    _redirectUrl += (/^\s*$/.test(_advThreeHours)?'':('&advThreeHours=' + _advThreeHours));
