    var _advStock = $('#checkAdvStock:checked').val();
    var _advTomorrow = $('#checkTomorrow:checked').val();
    var _advPrefere = $('#checkPrefere:checked').val();
    var _advTvshop = $('#checkTvshop:checked').val();
