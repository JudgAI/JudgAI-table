    // fix Goods Stock that span with attrib "GDS"
    var _defaultSettings = {
      data:{
        flag:2004,
        goodsCode:[]
      }
    };
    var _settings = $.extend(_defaultSettings, settings);
    
    $('span[GDSStock]').each(function(){
      _settings.data.goodsCode.push($(this).attr("GDSStock").replace(/^GDS-/,""));
