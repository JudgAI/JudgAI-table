  body += `我們將儘快安排專人與您聯繫。謝謝!`;
  
  const encodedSubject = encodeURIComponent(subject);
  const encodedBody = encodeURIComponent(body);
  
  // 打開郵件客戶端
  const mailtoLink = `mailto:${sellerEmail}?subject=${encodedSubject}&body=${encodedBody}`;
  
